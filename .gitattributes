# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf

# Batch files
*.bat text eol=crlf

# Shell scripts
*.sh text eol=lf

# Markdown
*.md text eol=lf

# Documents
*.txt text eol=lf

# Graphics
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary
